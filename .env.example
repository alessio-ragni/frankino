# Copia in server/.env e riempi. Il file .env non entra mai nella repo.

# Gettone che il tablet manda a ogni collegamento. Generalo con: openssl rand -hex 24
FRANKINO_TOKEN=

# Dove il server tiene database e audio (fuori dalla repo)
FRANKINO_DATA=~/.frankino
FRANKINO_HOST=0.0.0.0
FRANKINO_PORT=4390
FRANKINO_TZ=Europe/Rome

# Il cervello: Claude Code col login del TUO abbonamento (`claude` → /login, una volta).
# NON impostare ANTHROPIC_API_KEY: se c'è, la CLI usa la chiave invece dell'abbonamento.
FRANKINO_MODEL=claude-sonnet-5-5

# Capire e parlare: openai | elevenlabs (si possono mischiare)
FRANKINO_STT=openai
FRANKINO_TTS=openai
OPENAI_API_KEY=
FRANKINO_OPENAI_STT_MODEL=gpt-4o-transcribe
FRANKINO_OPENAI_TTS_MODEL=gpt-4o-mini-tts
FRANKINO_OPENAI_VOICE=ash

ELEVENLABS_API_KEY=
FRANKINO_ELEVENLABS_VOICE_ID=
FRANKINO_ELEVENLABS_STT_MODEL=scribe_v1
FRANKINO_ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Gli audio si cancellano dopo questi giorni; il testo trascritto resta
FRANKINO_AUDIO_DAYS=30
# Versione A2UI parlata con il tablet (il renderer Android ufficiale legge v0.9.1)
FRANKINO_A2UI_VERSION=v0.9.1
# Quanto aspetta una conferma prima di considerarla un no (secondi)
FRANKINO_CONFIRM_TIMEOUT_S=120
